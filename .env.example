# Copy this file to .env and fill in real values. Never commit .env.

# Server
# Do not set NODE_ENV here: `npm run dev` runs in development and `npm run build`/`npm start` run in production automatically.
PORT=3000

# Public address of the deployed app. Used for the vendor quote links in RFQ emails, so links
# work for vendors even when an RFQ is sent from a local copy. Needed at build time (Vite).
VITE_PUBLIC_APP_URL=https://your-app.vercel.app

# Vercel only: protects the daily payment-reminder job (/api/cron/payment-reminders).
# Any long random string; Vercel sends it automatically to the cron job.
CRON_SECRET=

# MongoDB (all application data is stored here)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/
MONGODB_DB=brickfour_inventory

# Gemini AI API key (procurement assistant, market benchmarks, rate predictions).
# Optional: the app falls back to built-in estimates when it is not set.
GEMINI_API_KEY=your-gemini-api-key

# Resend API key for email notifications
RESEND_API_KEY=re_your_resend_api_key
# Sender for all emails. The domain must be verified at resend.com/domains,
# otherwise Resend only delivers to your own Resend account address.
EMAIL_FROM="Brickfour Procurement <noreply@yourdomain.com>"
# Company details printed on purchase orders (Bill To / header). GSTIN decides CGST+SGST vs IGST.
COMPANY_NAME="Brickfour"
COMPANY_ADDRESS="Office address, City, State PIN"
COMPANY_GSTIN=
COMPANY_PAN=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_JURISDICTION=Pune

# Internal inbox for notifications that have no specific recipient
NOTIFICATION_EMAIL=notifications@example.com

# Vendor payment reminders (sent 2 days before an invoice's due date).
# Comma-separated list; defaults to NOTIFICATION_EMAIL when empty.
ACCOUNTS_EMAIL=accounts@example.com
# How often (minutes) the server checks for due invoices
REMINDER_INTERVAL_MINUTES=60
